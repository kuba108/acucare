# Resend API Key (Získejte na https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_your_api_key_here

# E-mail, na který mají chodit přijaté objednávky
NOTIFICATION_EMAIL=info@acucare.cz

# Odesílatel e-mailu (pokud nemáte ověřenou vlastní doménu v Resend, použijte výchozí onboarding e-mail)
RESEND_FROM_EMAIL=AcuCare <onboarding@resend.dev>
